{
  "name": "@leepepe/loki-web",
  "version": "0.1.0",
  "description": "TypeScript Web SDK for Grafana Loki telemetry. Mirrors the Swift LokiKit API.",
  "license": "MIT",
  "author": "LeePepe",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:contract": "node --test scripts/check-distribution.test.mjs",
    "test:distribution": "node scripts/check-distribution.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "devDependencies": {
    "ajv": "8.17.1",
    "@types/node": "^20.11.0",
    "happy-dom": "^13.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
