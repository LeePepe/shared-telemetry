{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "LokiKit Swift AI registry v1",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "library", "releaseUnit", "product", "module", "version", "releaseStatus", "wireSchema", "documents", "capabilities", "example"],
  "properties": {
    "$schema": {"const": "registry.schema.json"}, "schemaVersion": {"const": 1},
    "library": {"const": "shared-telemetry"}, "releaseUnit": {"const": "LokiKit-swift"},
    "product": {"const": "LokiKit"}, "module": {"const": "LokiKit"}, "version": {"const": "0.1.0"},
    "releaseStatus": {"enum": ["unreleased", "released"]},
    "wireSchema": {"const": "loki-push-v1; inner line not versioned"},
    "documents": {"type": "object", "additionalProperties": false,
      "required": ["entry", "usage", "integration", "examples", "compatibility", "migration", "changelog"],
      "properties": {"entry": {"const": "README.md"}, "usage": {"const": "USAGE.md"}, "integration": {"const": "INTEGRATION.md"}, "examples": {"const": "EXAMPLES.md"}, "compatibility": {"const": "COMPATIBILITY.md"}, "migration": {"const": "MIGRATION.md"}, "changelog": {"const": "CHANGELOG.md"}}
    },
    "capabilities": {"type": "array", "minItems": 10, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "source"],
        "properties": {"symbol": {"type": "string"}, "source": {"type": "string"}}
      }
    },
    "example": {"const": "examples/swift/Tests/ConsumerTests/ConsumerTests.swift"}
  }
}
